    <string name="cleanup_primary_canvas">首要后端 · 推荐</string>
    <string name="cleanup_primary_canvas_enable">使用首要后台画布</string>
    <string name="cleanup_primary_canvas_summary">原虚拟屏后端，新配置默认开启。需要 Root 与 Android 14+。打开本页不会改变已保存设置。独立显示不等于应用多开；同名应用可能共享数据或在屏幕间迁移。</string>
    <string name="cleanup_advanced_compatibility">高级与兼容</string>
    <string name="cleanup_compat_canvas">兼容后端 · 灵屏</string>
    <string name="cleanup_compat_canvas_summary">独立保留的另一后端：浮窗预览、贴边折叠、保持亮屏及日志。开关沿用原配置，进入不会自动切换引擎。</string>
    <string name="cleanup_compat_canvas_enable">启用兼容灵屏</string>
    <string name="cleanup_compat_canvas_enable_summary">需要 Root 与 Android 14+。仅控制本兼容后端，不改变首要画布开关。同一时间仅运行一个灵屏任务；显示隔离不等于数据隔离，也不保证同名应用留在主屏。</string>
    <string name="cleanup_task_running">任务进行时</string>
    <string name="cleanup_idle_pinned">空闲时</string>
    <string name="cleanup_fluid_running">任务进度使用流体云</string>
    <string name="cleanup_fluid_running_summary">开启：系统支持时允许提升任务进度。关闭：使用普通通知；现有降级策略也影响空闲入口的提升，不会关闭任务通知。</string>
    <string name="cleanup_fluid_idle">空闲时常驻入口</string>
    <string name="cleanup_fluid_idle_summary">没有任务时也保留 Eta 通知。独立保存此偏好；是否提升为流体云还受上方进度提升开关、系统支持和通知权限影响。</string>
