    <string name="cleanup_primary_canvas_enable">Use the primary background canvas</string>
    <string name="cleanup_primary_canvas_summary">Original virtual-display backend, enabled by default for new configurations. Requires Root and Android 14+. Opening this page does not change saved settings. A separate display is not a separate app instance; the same app can share data or move between displays.</string>
    <string name="cleanup_advanced_compatibility">Advanced &amp; compatibility</string>
    <string name="cleanup_compat_canvas">Compatibility backend · virtual screen</string>
    <string name="cleanup_compat_canvas_summary">Separate existing backend: floating preview, edge collapse, keep-screen-on and logs. Its saved switch is independent; entering does not switch engines.</string>
    <string name="cleanup_compat_canvas_enable">Enable compatibility virtual screen</string>
    <string name="cleanup_compat_canvas_enable_summary">Requires Root and Android 14+. Controls only this compatibility backend; it does not change the primary canvas switch. One virtual-screen task at a time. Display separation does not isolate app data or guarantee that the same app stays on the main screen.</string>
    <string name="cleanup_task_running">While a task is running</string>
    <string name="cleanup_idle_pinned">When idle</string>
    <string name="cleanup_fluid_running">Task progress in Fluid Cloud</string>
    <string name="cleanup_fluid_running_summary">On: allow promoted task progress on supported systems. Off: use ordinary notifications; the existing downgrade policy also affects the idle entry. Task notifications are not disabled.</string>
    <string name="cleanup_fluid_idle">Keep an idle entry</string>
    <string name="cleanup_fluid_idle_summary">Keep an Eta notification when no task is running. Saved separately; Fluid Cloud appearance also depends on the promotion switch above, system support and notification permissions.</string>
